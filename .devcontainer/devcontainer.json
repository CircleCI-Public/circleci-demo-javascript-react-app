{
  "name": "Baby Hippo Gram",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Vite dev server" }
  },
  // Passed through from your machine when set there. Nothing secret is stored in this file.
  "remoteEnv": {
    "CIRCLE_TOKEN": "${localEnv:CIRCLE_TOKEN}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "vitest.explorer"]
    }
  }
}
