{
  "commands": [
    {
      "name": "test",
      "run": "yarn test",
      "role": "gate",
      "fileExt": ".js",
      "timeout": 300,
      "remote": true
    },
    {
      "name": "build",
      "run": "yarn build",
      "role": "gate",
      "fileExt": ".js",
      "timeout": 300,
      "remote": true
    }
  ],
  "vcs": {
    "org": "CircleCI-Public",
    "repo": "circleci-demo-javascript-react-app"
  },
  "environment": {
    "stack": "javascript",
    "setup": [
      {
        "name": "system",
        "command": "curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - && sudo apt-get install -y nodejs --no-install-recommends && sudo rm -rf /var/lib/apt/lists/*"
      },
      {
        "name": "yarn",
        "command": "npm install -g yarn@1.22.22"
      },
      {
        "name": "install",
        "command": "yarn install --frozen-lockfile"
      }
    ],
    "image": "cimg/node",
    "image_version": "20.20.2"
  }
}
